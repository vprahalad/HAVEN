# HAVEN Backend Configuration
# Copy this file to .env and fill in your actual values

# Flask Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True

# Database
# Use SQLite by default, or provide a PostgreSQL/MySQL connection string
DATABASE_URL=sqlite:///haven.db

# CORS Configuration
# Comma-separated list of allowed origins, or * for all origins
FRONTEND_ORIGIN=http://localhost:3000

# Roboflow API Configuration
# Get your API key from https://roboflow.com
# Model ID format: {workspace}/{project}/{version}
# Example: natural-disaster-damage-8txjn-hndy0/2
ROBOFLOW_API_KEY=your-roboflow-api-key
ROBOFLOW_MODEL_ID=your-workspace/your-project/1

# Google Maps API Configuration
# Get your API key from https://console.cloud.google.com/
# Enable: Geocoding API and Directions API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

